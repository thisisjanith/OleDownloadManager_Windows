<Window x:Class="OleDownloadManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OleDownloadManager.App.ViewModels"
        xmlns:controls="clr-namespace:OleDownloadManager.App.Controls"
        Title="OleDownloadManager"
        Width="1280" Height="760" MinWidth="760" MinHeight="460"
        Style="{StaticResource AppWindowStyle}"
        AllowDrop="True"
        AutomationProperties.AutomationId="MainWindow">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddDownloadCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SettingsCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RetryCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding AddMediaCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding ToggleDetailsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ContextMenu x:Key="RowMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Start / Resume" Command="{Binding StartCommand}" InputGestureText="Space">
                <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pause" Command="{Binding PauseCommand}" InputGestureText="Space">
                <MenuItem.Icon><TextBlock Text="&#xE769;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Retry" Command="{Binding RetryCommand}" InputGestureText="Ctrl+R">
                <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Cancel" Command="{Binding CancelCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" InputGestureText="Enter">
                <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in File Explorer" Command="{Binding RevealCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copy URL" Command="{Binding CopyUrlCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE71B;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy File Path" Command="{Binding CopyPathCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Move Up in Queue" Command="{Binding MoveUpCommand}" />
            <MenuItem Header="Move Down in Queue" Command="{Binding MoveDownCommand}" />
            <MenuItem Header="Priority">
                <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High" />
                <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal" />
                <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="Low" />
            </MenuItem>
            <MenuItem Header="Speed Limit" ItemsSource="{x:Static vm:AddDownloadViewModel.SpeedLimitChoices}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Label}" />
                        <Setter Property="Command" Value="{Binding DataContext.SetSpeedLimitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter" Value="{Binding Value}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Schedule…" Command="{Binding ScheduleCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE823;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Download Again" Command="{Binding RedownloadCommand}" />
            <MenuItem Header="Delete Incomplete Data" Command="{Binding DeleteIncompleteCommand}" />
            <MenuItem Header="Restore from Trash" Command="{Binding RestoreCommand}" />
            <MenuItem Header="Remove from History" Command="{Binding RemoveCommand}" InputGestureText="Del">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="14" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CategoryIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource CategoryOtherBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="Applications"><Setter Property="Foreground" Value="{DynamicResource CategoryApplicationsBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Documents"><Setter Property="Foreground" Value="{DynamicResource CategoryDocumentsBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Archives"><Setter Property="Foreground" Value="{DynamicResource CategoryArchivesBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Video"><Setter Property="Foreground" Value="{DynamicResource CategoryVideoBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Audio"><Setter Property="Foreground" Value="{DynamicResource CategoryAudioBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Images"><Setter Property="Foreground" Value="{DynamicResource CategoryImagesBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Active"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneProgress" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Margin" Value="0,8,0,1" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="-2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= Menu -->
        <Menu Grid.Row="0" Padding="4,2" Background="{DynamicResource ToolbarBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Add Download…" Command="{Binding AddDownloadCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="Add _Media / Playlist…" Command="{Binding AddMediaCommand}" InputGestureText="Ctrl+M" />
                <MenuItem Header="_Paste URL" Command="{Binding PasteUrlCommand}" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Downloads">
                <MenuItem Header="_Start / Resume" Command="{Binding StartCommand}" />
                <MenuItem Header="_Pause" Command="{Binding PauseCommand}" />
                <MenuItem Header="_Retry" Command="{Binding RetryCommand}" InputGestureText="Ctrl+R" />
                <MenuItem Header="_Cancel" Command="{Binding CancelCommand}" />
                <MenuItem Header="Download _Again" Command="{Binding RedownloadCommand}" />
                <Separator />
                <MenuItem Header="_Open File" Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Show in File _Explorer" Command="{Binding RevealCommand}" />
                <Separator />
                <MenuItem Header="Remove from _History" Command="{Binding RemoveCommand}" InputGestureText="Del" />
                <MenuItem Header="Delete _Incomplete Data" Command="{Binding DeleteIncompleteCommand}" />
                <MenuItem Header="Empty _Trash" Command="{Binding EmptyTrashCommand}" />
            </MenuItem>
            <MenuItem Header="_Queue">
                <MenuItem Header="_Start Queue" Command="{Binding StartQueueCommand}" />
                <MenuItem Header="_Pause Queue" Command="{Binding PauseQueueCommand}" />
                <Separator />
                <MenuItem Header="Pause _All" Command="{Binding PauseAllCommand}" />
                <MenuItem Header="_Resume All" Command="{Binding ResumeAllCommand}" />
                <Separator />
                <MenuItem Header="Move _Up" Command="{Binding MoveUpCommand}" />
                <MenuItem Header="Move _Down" Command="{Binding MoveDownCommand}" />
                <MenuItem Header="S_chedule…" Command="{Binding ScheduleCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Details Panel" IsCheckable="True" IsChecked="{Binding DetailsVisible}" InputGestureText="F9" />
                <MenuItem Header="_Search" Command="{Binding FocusSearchCommand}" InputGestureText="Ctrl+F" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings…" Command="{Binding SettingsCommand}" InputGestureText="Ctrl+," />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About OleDownloadManager" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ================================================= Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding AddDownloadCommand}" ToolTip="Add a download (Ctrl+N)" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="AddDownloadButton" AutomationProperties.Name="Add Download">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AccentForegroundBrush}" />
                            <TextBlock Text="Add Download" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PasteUrlCommand}" ToolTip="Add the link on the clipboard (Ctrl+V)" AutomationProperties.Name="Paste URL">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Paste URL" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddMediaCommand}" ToolTip="Add videos or a playlist using yt-dlp (Ctrl+M)" AutomationProperties.Name="Media and Playlists">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Media" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerBrush}" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartCommand}" ToolTip="Start or resume the selected downloads" AutomationProperties.Name="Resume">
                        <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PauseCommand}" ToolTip="Pause the selected downloads (Space)" AutomationProperties.Name="Pause">
                        <TextBlock Text="&#xE769;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RetryCommand}" ToolTip="Retry failed downloads (Ctrl+R)" AutomationProperties.Name="Retry">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RemoveCommand}" ToolTip="Remove the selected downloads from the list (Delete)" AutomationProperties.Name="Remove">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
                    </Button>
                    <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource DividerBrush}" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartQueueCommand}" ToolTip="Start processing the queue (also resumes downloads paused by Pause Queue)" AutomationProperties.Name="Start Queue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Start Queue" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PauseQueueCommand}" ToolTip="Pause the queue and the downloads it started" AutomationProperties.Name="Pause Queue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE769;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Pause Queue" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ResumeAllCommand}" ToolTip="Resume all paused downloads and start the queue" AutomationProperties.Name="Resume All">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Resume All" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="220" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,8,5"
                                 AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search downloads" ToolTip="Search by file name or host (Ctrl+F)" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" />
                        <TextBlock Text="Search" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDisabledBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=Invert}" />
                    </Grid>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleDetailsCommand}" ToolTip="Show or hide the details panel (F9)" AutomationProperties.Name="Toggle details">
                        <TextBlock Text="&#xE8A0;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SettingsCommand}" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================= Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" MinWidth="170" MaxWidth="320" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="DetailsColumn" Width="300" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <StackPanel>
                        <ListBox x:Name="SectionList" ItemsSource="{Binding Sections}" Style="{StaticResource NavListBox}"
                                 ItemTemplate="{StaticResource NavItemTemplate}" AutomationProperties.Name="Sections">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="CATEGORIES" Style="{StaticResource SecondaryText}" FontSize="11" FontWeight="SemiBold" Margin="18,16,0,4" />
                        <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}" Style="{StaticResource NavListBox}"
                                 ItemTemplate="{StaticResource NavItemTemplate}" AutomationProperties.Name="Categories">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Download list -->
            <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="16,10,12,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding EmptyTrashCommand}" Content="Empty Trash"
                            Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ListTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ListView x:Name="DownloadList" Grid.Row="1" ItemsSource="{Binding View}" Style="{StaticResource DownloadListView}"
                          ItemContainerStyle="{StaticResource DownloadListViewItem}" Tag="{Binding}" ContextMenu="{StaticResource RowMenu}"
                          SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnListDoubleClick" SizeChanged="OnListSizeChanged"
                          AutomationProperties.AutomationId="DownloadList" AutomationProperties.Name="Downloads">
                    <ListView.InputBindings>
                        <KeyBinding Key="Space" Command="{Binding TogglePauseCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding OpenFileCommand}" />
                        <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteUrlCommand}" />
                    </ListView.InputBindings>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="280">
                                <GridViewColumn.Header>
                                    <Button Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="FileName">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Name" />
                                            <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="FileName">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDescending" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CategoryGlyph}" Style="{StaticResource CategoryIcon}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding FileName}" />
                                                <TextBlock Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding HostName, Mode=OneWay}" />
                                                    <Run Text="{Binding LastError, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}" Foreground="{DynamicResource WarningBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="115">
                                <GridViewColumn.Header>
                                    <Button Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Size">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Size" />
                                            <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Size">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDescending" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource SecondaryText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="172">
                                <GridViewColumn.Header>
                                    <Button Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Progress">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Progress" />
                                            <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Progress">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDescending" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="150">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="38" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                                             Style="{StaticResource ToneProgress}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock Text="{Binding TransferText}" Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding TransferText, Converter={StaticResource NotEmptyToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="140">
                                <GridViewColumn.Header>
                                    <Button Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="Status">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Status" />
                                            <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Status">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDescending" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource ToneText}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastError}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="76">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RowActionButton}" ToolTip="{Binding PrimaryActionText}"
                                                    AutomationProperties.Name="{Binding PrimaryActionText}"
                                                    Command="{Binding DataContext.RowActionCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding PrimaryActionGlyph}" Style="{StaticResource IconText}" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource RowActionButton}" ToolTip="Show in File Explorer" AutomationProperties.Name="Show in folder"
                                                    Click="OnRevealRowClick" Tag="{Binding}" IsEnabled="{Binding CanReveal}">
                                                <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="118">
                                <GridViewColumn.Header>
                                    <Button Style="{StaticResource HeaderButton}" Command="{Binding SortCommand}" CommandParameter="CreatedAt">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Added" />
                                            <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="CreatedAt">
                                                        <Binding Path="SortColumn" />
                                                        <Binding Path="SortDescending" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource SecondaryText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="40" Foreground="{DynamicResource TextDisabledBrush}" />
                    <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Details panel -->
            <Border x:Name="DetailsPanel" Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding DetailsVisible, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Download details">
                <Grid>
                    <TextBlock Text="Select a download to see its details." Style="{StaticResource SecondaryText}" Margin="16" TextWrapping="Wrap"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedItem}"
                                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="16,12,16,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CategoryGlyph}" Style="{StaticResource CategoryIcon}" FontSize="28" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource ToneText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Text="{Binding FileName, Mode=OneWay}" Style="{StaticResource DetailValue}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />

                            <Border Style="{StaticResource NoticeBorder}" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Text="{Binding LastError, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            </Border>

                            <TextBlock Text="Progress" Style="{StaticResource DetailLabel}" Margin="0,14,0,4" />
                            <controls:SegmentBar Segments="{Binding Segments}" Total="{Binding TotalForSegments}" Height="10"
                                                 Fill="{DynamicResource AccentBrush}" Track="{DynamicResource ProgressTrackBrush}" Divider="{DynamicResource SurfaceBrush}"
                                                 ToolTip="Each block is one part of the file; filled areas have been downloaded." />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Speed" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding SpeedText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Average" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding DetailAverageSpeed}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Time left" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding EtaText}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Connections" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding DetailConnections}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Speed limit" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding DetailSpeedLimit}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Priority" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding DetailPriority}" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Size" Style="{StaticResource DetailLabel}" />
                            <TextBox Text="{Binding DetailSize, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="Downloaded" Style="{StaticResource DetailLabel}" />
                            <TextBox Text="{Binding DetailDownloaded, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="Resume" Style="{StaticResource DetailLabel}" />
                            <TextBox Text="{Binding DetailResume, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="Saved to" Style="{StaticResource DetailLabel}" />
                            <TextBox Text="{Binding DestinationPath, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="Address" Style="{StaticResource DetailLabel}" />
                            <TextBox Text="{Binding SourceUrl, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            <StackPanel Visibility="{Binding FinalUrl, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="Redirected to" Style="{StaticResource DetailLabel}" />
                                <TextBox Text="{Binding FinalUrl, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding PageUrl, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="From page" Style="{StaticResource DetailLabel}" />
                                <TextBox Text="{Binding PageUrl, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <TextBlock Text="Added" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding CreatedText}" />
                            <StackPanel Visibility="{Binding DetailCompleted, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="Completed" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding DetailCompleted}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding DetailSha256, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="SHA-256 (computed locally)" Style="{StaticResource DetailLabel}" />
                                <TextBox Text="{Binding DetailSha256, Mode=OneWay}" Style="{StaticResource DetailValue}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding DetailExpectedSha256, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="Expected SHA-256" Style="{StaticResource DetailLabel}" />
                                <TextBox Text="{Binding DetailExpectedSha256, Mode=OneWay}" Style="{StaticResource DetailValue}" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding DetailETag, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="ETag" Style="{StaticResource DetailLabel}" />
                                <TextBox Text="{Binding DetailETag, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding DetailLastModified, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="Last modified on server" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding DetailLastModified}" />
                            </StackPanel>
                            <TextBlock Text="Retries" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding DetailRetries}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================= Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="16,0,0,0">
                        <Run Text="{Binding ActiveCount, Mode=OneWay}" /><Run Text=" active" />
                    </TextBlock>
                    <TextBlock Text="{Binding TotalSpeedText}" Style="{StaticResource SecondaryText}" Margin="16,0,0,0" MinWidth="70" />
                    <TextBlock Text="{Binding QueueStatusText}" Style="{StaticResource SecondaryText}" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding SpeedLimitText}" Style="{StaticResource SecondaryText}" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StatusMessage" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
