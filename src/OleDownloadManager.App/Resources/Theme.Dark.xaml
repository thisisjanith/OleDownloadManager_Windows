<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#FF4CC2FF</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF272727" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="ToolbarBrush" Color="#FF232323" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF383838" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF353535" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#FF262626" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF6E6E6E" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6CCEFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF3AA9E0" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF000000" />

    <SolidColorBrush x:Key="SelectionBrush" Color="#FF1E3A50" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FF2F2F2F" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF8A8A8A" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FF433519" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FF442726" />

    <SolidColorBrush x:Key="CategoryApplicationsBrush" Color="#FFA594F9" />
    <SolidColorBrush x:Key="CategoryDocumentsBrush" Color="#FF6CA6FF" />
    <SolidColorBrush x:Key="CategoryArchivesBrush" Color="#FFF0A64B" />
    <SolidColorBrush x:Key="CategoryVideoBrush" Color="#FFFF7A7E" />
    <SolidColorBrush x:Key="CategoryAudioBrush" Color="#FF4CD6C4" />
    <SolidColorBrush x:Key="CategoryImagesBrush" Color="#FFF07FE2" />
    <SolidColorBrush x:Key="CategoryOtherBrush" Color="#FFA0A0A0" />
</ResourceDictionary>
