<Application x:Class="OleDownloadManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OleDownloadManager.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the colour palette; ThemeService swaps it at runtime. -->
                <ResourceDictionary Source="Resources/Theme.Light.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <controls:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <controls:SortGlyphConverter x:Key="SortGlyph" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
