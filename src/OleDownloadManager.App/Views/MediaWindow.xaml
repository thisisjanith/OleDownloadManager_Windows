<Window x:Class="OleDownloadManager.App.Views.MediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OleDownloadManager.App.ViewModels"
        Title="Download Video or Playlist" Width="720" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}" AutomationProperties.AutomationId="MediaWindow">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource NoticeBorder}">
            <StackPanel>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                <Button Content="I understand" Command="{Binding AcknowledgeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Visibility="{Binding Acknowledged, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" IsEnabled="{Binding Acknowledged}">
            <TextBlock Text="Video or playlist address (YouTube and other sites supported by yt-dlp)" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Media address" AutomationProperties.AutomationId="MediaUrlBox" />
                <Button Grid.Column="1" Content="Get qualities" Command="{Binding InspectCommand}" Margin="8,0,0,0" IsDefault="True" />
            </Grid>
            <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
            <DockPanel Margin="0,4,0,0" Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}">
                <Button DockPanel.Dock="Right" Content="Update yt-dlp" Command="{Binding UpdateToolCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="MediaError" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="10,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Select all" Style="{StaticResource ToolbarButton}" Command="{Binding SelectAllCommand}" />
                        <Button Content="Select none" Style="{StaticResource ToolbarButton}" Command="{Binding SelectNoneCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding ListTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource PlainListBoxItem}" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MediaEntryViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0" AutomationProperties.Name="{Binding Title}" />
                                <TextBlock Grid.Column="1" Text="{Binding IndexText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0" IsEnabled="{Binding Acknowledged}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Quality" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Format}" AutomationProperties.AutomationId="QualityBox" AutomationProperties.Name="Quality" />
                <TextBlock Text="{Binding FfmpegNote}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding FfmpegNote, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Save to" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="…" MinWidth="32" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Add to Queue" Command="{Binding AddToQueueCommand}" Margin="0,0,8,0" />
            <Button Content="Download Now" Command="{Binding AddNowCommand}" Style="{StaticResource AccentButton}" AutomationProperties.AutomationId="MediaDownloadNowButton" />
        </StackPanel>
    </Grid>
</Window>
