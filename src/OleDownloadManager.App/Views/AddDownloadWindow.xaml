<Window x:Class="OleDownloadManager.App.Views.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OleDownloadManager.App.ViewModels"
        Title="Add Download" Width="580" SizeToContent="Height" MaxHeight="900"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}" AutomationProperties.AutomationId="AddDownloadWindow">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
            <StackPanel>
                <TextBlock Text="Address" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="UrlBox"
                         AutomationProperties.Name="Download address" />
                <TextBlock Text="{Binding UrlError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding UrlError, Converter={StaticResource NotEmptyToVisibility}}" />
                <TextBlock Text="{Binding ProbeSummary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ProbeSummary"
                           Visibility="{Binding ProbeSummary, Converter={StaticResource NotEmptyToVisibility}}" />
                <Border Style="{StaticResource NoticeBorder}" Margin="0,8,0,0" Visibility="{Binding DuplicateNotice, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock Text="{Binding DuplicateNotice}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource NoticeBorder}" Margin="0,8,0,0" Visibility="{Binding IsMediaPage, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Choose video quality…" Command="{Binding OpenAsMediaCommand}" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                                AutomationProperties.AutomationId="OpenAsMediaButton" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="This link is a video page, not a file. The video is downloaded with yt-dlp so you can pick the quality." />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource NoticeBorder}" Margin="0,8,0,0" Visibility="{Binding IsWebPage, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Try as video…" Command="{Binding OpenAsMediaCommand}" Margin="10,0,0,0" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="This address returns a web page (HTML), not a file. If the page contains a video, try downloading it as a video." />
                    </DockPanel>
                </Border>

                <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FileNameBox" AutomationProperties.Name="File name" />
                <Border Style="{StaticResource NoticeBorder}" Margin="0,8,0,0" Visibility="{Binding FileExists, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="A file with this name already exists in the folder. When the download finishes:" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <RadioButton Content="Keep both (rename)" IsChecked="{Binding ConflictRename}" Margin="0,0,16,0" />
                            <RadioButton Content="Replace" IsChecked="{Binding ConflictReplace}" Margin="0,0,16,0" />
                            <RadioButton Content="Skip" IsChecked="{Binding ConflictSkip}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Save to" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DestinationBox" AutomationProperties.Name="Destination folder" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding FreeSpaceText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:AddDownloadViewModel.CategoryChoices}" SelectedItem="{Binding Category}" AutomationProperties.Name="Category" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:AddDownloadViewModel.PriorityChoices}" SelectedItem="{Binding Priority}" AutomationProperties.Name="Priority" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Show advanced options" IsChecked="{Binding ShowAdvanced}" Margin="0,14,0,0" />
                <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Connections" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{x:Static vm:AddDownloadViewModel.ConnectionChoices}" SelectedItem="{Binding Connections}"
                                      IsEnabled="{Binding Acceleration}" AutomationProperties.Name="Connections" />
                            <CheckBox Content="Use multiple connections when the server allows" IsChecked="{Binding Acceleration}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Speed limit for this download" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{x:Static vm:AddDownloadViewModel.SpeedLimitChoices}" SelectedItem="{Binding SpeedLimit}" AutomationProperties.Name="Speed limit" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="More connections are not always faster; servers may limit or reject parallel requests." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <CheckBox Content="Start at a scheduled time" IsChecked="{Binding ScheduleEnabled}" Margin="0,12,0,0" />
                    <TextBox Text="{Binding ScheduleText, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"
                             IsEnabled="{Binding ScheduleEnabled}" ToolTip="YYYY-MM-DD HH:MM, 24-hour, local time" AutomationProperties.Name="Scheduled start time" />
                    <TextBlock Text="The computer must be awake and OleDownloadManager running at that time." Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

                    <TextBlock Text="Custom request headers (one per line, Name: Value)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding HeadersText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" Height="64"
                             AutomationProperties.Name="Custom request headers" />

                    <TextBlock Text="Authentication (HTTP Basic)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" ToolTip="User name" AutomationProperties.Name="User name" />
                        <PasswordBox x:Name="PasswordBox" Grid.Column="2" ToolTip="Password" AutomationProperties.Name="Password" />
                    </Grid>
                    <CheckBox IsChecked="{Binding RememberCredentials}" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Remember the password and sensitive headers in Windows Credential Manager so the download can resume after a restart. Otherwise they are kept in memory only." />
                    </CheckBox>
                    <TextBlock Text="Credentials are sent only to the original site, never to redirect targets on other hosts." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="26,2,0,0" />

                    <TextBlock Text="Expected SHA-256 checksum (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ExpectedSha256, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             AutomationProperties.Name="Expected SHA-256 checksum" />
                    <TextBlock Text="If provided, the file is only saved when its checksum matches." Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,12,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.AutomationId="AddError" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" AutomationProperties.AutomationId="CancelButton" />
            <Button Content="Add to Queue" Command="{Binding AddToQueueCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="AddToQueueButton" />
            <Button Content="Start Now" Command="{Binding StartNowCommand}" Style="{StaticResource AccentButton}" IsDefault="True" AutomationProperties.AutomationId="StartNowButton" />
        </StackPanel>
    </Grid>
</Window>
